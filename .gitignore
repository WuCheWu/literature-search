# ---- 运行时产物：不进仓库 ----
# 本机配置：含学校 VPN 门户、本机路径，公开仓库里只留 config.example.json
config.json
selectors.json

# 平台能力探测缓存、登录状态缓存（与本机浏览器 profile 绑定）
_平台能力/
_平台登录/
platform_learned.json

# 本机浏览器 profile（含 Cookie，体积大且不可移植）
.lit-profile/

# 凭据：永不提交
credentials.json

# 测试临时物（本地假站点验证用）
_testsite/
_test_*
_test*/

# Python
__pycache__/
*.py[cod]
.venv/

# 内部开发日志：含本机网络与调试细节，只留本地，不发布
开发提示词*.md

# 日志与临时输出
*.log
run.log

# 检索结果目录（含全文 PDF，体积大，留在 文献检索/ 下即可）
全文/
platforms.local.json
